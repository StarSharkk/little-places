{
  "name": "little-places-building-series",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "check": "node scripts/verify.mjs",
    "check:bakery": "node scripts/verify-bakery.mjs",
    "check:flowers": "node scripts/verify-flowers.mjs",
    "check:sweets": "node scripts/verify-sweets.mjs",
    "check:books": "node scripts/verify-books.mjs",
    "check:pizza": "node scripts/verify-pizza.mjs",
    "check:laundry": "node scripts/verify-laundry.mjs",
    "check:post": "node scripts/verify-post.mjs",
    "check:navigation": "node scripts/verify-navigation.mjs",
    "check:tram": "node scripts/verify-tram.mjs",
    "check:rotation": "node scripts/verify-rotation.mjs",
    "check:explorer": "node scripts/verify-explorer.mjs && node scripts/verify-explorer-lifecycle.mjs",
    "previews:explorer": "node scripts/generate-explorer-previews.mjs",
    "check:explorer-layout": "node scripts/verify-explorer-layout.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "playwright": "1.61.1"
  }
}
